{
  "name": "north-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --host lan",
    "dev": "expo start --dev-client --host lan --clear",
    "dev:tunnel": "expo start --dev-client --tunnel --clear",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pbt": "jest --testPathPattern=property",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --config jest.integration.config.js",
    "validate:tokens": "jest design-system/__tests__/token-validation.test.ts --verbose",
    "validate:tokens:ci": "jest design-system/__tests__/token-validation.test.ts --ci --json --outputFile=validation-results.json",
    "setup:service-account": "node scripts/setup-service-account.js",
    "prebuild": "npm run setup:service-account",
    "presubmit": "npm run setup:service-account"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.0",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.0.0",
    "@supabase/supabase-js": "^2.93.2",
    "expo": "~54.0.32",
    "expo-apple-authentication": "^8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "^8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "^8.0.11",
    "expo-notifications": "^0.32.16",
    "expo-router": "^6.0.22",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.7.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.3.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.2.0",
    "babel-preset-expo": "^54.0.10",
    "dotenv": "^17.2.3",
    "fast-check": "^4.5.3",
    "jest": "~29.7.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
