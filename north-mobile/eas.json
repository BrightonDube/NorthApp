{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "internal-testing",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal-testing": {
      "distribution": "internal",
      "channel": "internal-testing",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "${EXPO_PUBLIC_SUPABASE_URL}",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "${EXPO_PUBLIC_REVENUECAT_API_KEY}"
      }
    },
    "closed-testing": {
      "distribution": "internal",
      "channel": "closed-testing",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "${EXPO_PUBLIC_SUPABASE_URL}",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "${EXPO_PUBLIC_REVENUECAT_API_KEY}"
      }
    },
    "open-testing": {
      "distribution": "internal",
      "channel": "open-testing",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "${EXPO_PUBLIC_SUPABASE_URL}",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "${EXPO_PUBLIC_REVENUECAT_API_KEY}"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "${EXPO_PUBLIC_SUPABASE_URL}",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "${EXPO_PUBLIC_REVENUECAT_API_KEY}"
      }
    }
  },
  "submit": {
    "internal-testing": {
      "android": {
        "track": "internal"
      }
    },
    "closed-testing": {
      "android": {
        "track": "alpha"
      }
    },
    "open-testing": {
      "android": {
        "track": "beta"
      }
    },
    "production": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "track": "production"
      }
    }
  }
}
