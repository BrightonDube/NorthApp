{
  "cli": {
    "version": ">= 7.0.0",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "internal-testing": {
      "distribution": "internal",
      "channel": "internal-testing",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "closed-testing": {
      "distribution": "internal",
      "channel": "closed-testing",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "open-testing": {
      "distribution": "internal",
      "channel": "open-testing",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "serviceAccountKey": "${ANDROID_SERVICE_ACCOUNT_JSON}",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "internal-testing": {
      "android": {
        "serviceAccountKey": "${ANDROID_SERVICE_ACCOUNT_JSON}",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed-testing": {
      "android": {
        "serviceAccountKey": "${ANDROID_SERVICE_ACCOUNT_JSON}",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "open-testing": {
      "android": {
        "serviceAccountKey": "${ANDROID_SERVICE_ACCOUNT_JSON}",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKey": "${ANDROID_SERVICE_ACCOUNT_JSON}",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
