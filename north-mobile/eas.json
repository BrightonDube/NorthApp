{
  "cli": {
    "version": ">= 7.0.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "https://your-app.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "internal-testing": {
      "distribution": "internal",
      "channel": "internal-testing",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "https://your-app.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "closed-testing": {
      "distribution": "internal",
      "channel": "closed-testing",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "https://your-app.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "open-testing": {
      "distribution": "internal",
      "channel": "open-testing",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "https://your-app.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_API_URL": "https://your-app.railway.app"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "internal-testing": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed-testing": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "open-testing": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
