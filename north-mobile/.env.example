# =============================================================================
# North Mobile App - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from your Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# RevenueCat Configuration
# =============================================================================
# Get this from RevenueCat Dashboard: Project Settings > API Keys
# Use the PUBLIC API key (starts with 'appl_' for iOS or 'goog_' for Android)
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-api-key

# =============================================================================
# Gemini AI (Server-side only - Edge Functions)
# =============================================================================
# This is used by Supabase Edge Functions, NOT the mobile app
# Add this as a Supabase secret, not as an EAS env var
# GEMINI_KEY=your-gemini-api-key

# =============================================================================
# EAS Build & Submit (GitHub Actions CI/CD)
# =============================================================================
# These are stored as GitHub Secrets, NOT in .env

# EXPO_TOKEN - Get from expo.dev: Account Settings > Access Tokens
# Add as GitHub Secret: EXPO_TOKEN

# ANDROID_SERVICE_ACCOUNT_JSON - Google Play Console Service Account
# 1. Go to Google Cloud Console > IAM & Admin > Service Accounts
# 2. Create a service account with "Service Account User" role
# 3. Go to Google Play Console > Users and permissions
# 4. Invite the service account email with "Release manager" access
# 5. Download the JSON key and add the ENTIRE JSON content as GitHub Secret:
#    ANDROID_SERVICE_ACCOUNT_JSON

# =============================================================================
# iOS App Store Connect (for iOS builds - optional)
# =============================================================================
# APPLE_ID=your-apple-id@email.com
# ASC_APP_ID=your-app-store-connect-app-id
# APPLE_TEAM_ID=your-apple-team-id
