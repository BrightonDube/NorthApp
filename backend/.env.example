# Supabase
SUPABASE_URL=https://pigtshfobiwuwaionxpo.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# SUPABASE_JWT_SECRET removed - now using JWKS endpoint with ES256 algorithm

# LLM Provider (Groq only - for all AI services)
GROQ_API_KEY=your_groq_api_key_here

# Embeddings Provider (Voyage AI)
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
MEMORY_EMBEDDING_DIMENSIONS=1536

# Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_API_KEY=your_onesignal_rest_api_key_here

# Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-app.railway.app/v1/integrations/calendar/callback

# App
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8081,https://your-app.railway.app

# Monitoring & Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
